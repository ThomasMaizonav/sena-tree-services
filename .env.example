# Meta Pixel / Dataset ID from Meta Events Manager.
# Keep this numeric value in Vercel Production environment variables.
NEXT_PUBLIC_META_PIXEL_ID=

# Google service account that has Editor access to the leads spreadsheet.
# In Vercel, add these as Production environment variables (keep the private key secret).
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=
